# Copy to .env and replace the dashboard password and session secret before deployment.
NODE_ENV=production
AUTH_ENABLED=true
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Optional remote access profile.
NGROK_AUTH_TOKEN=

# Android Emulator / Linux KVM resource limits.
KVM_GID=108
MAX_DEVICES=10
EMULATOR_MEMORY_MB=2048
EMULATOR_VCPUS=2
EMULATOR_GPU_MODE=swiftshader
